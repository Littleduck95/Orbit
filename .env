# Orbit's Supabase project. Both values are public by design: the publishable
# key only grants what the row-level security in supabase/schema.sql allows,
# which is each signed-in person reading and writing their own rows.
#
# Leave either one empty (or override it with an empty environment variable)
# to run Orbit as before, saving only in this browser with no sign-in.
VITE_SUPABASE_URL=https://zteqzxfqodbhbrtzrmdf.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_gw1htm6jd7CnXbwCOuMeLg_cBK5T1Wo

# The public half of the key pair that signs push notifications. Public by
# design; the private half is only ever a secret on the notify function.
VITE_VAPID_PUBLIC_KEY=BM1-5-9pBVAwr91xakUshITRNyFi9JGhubXtMavHtX8fqwoxwDoOjzJbYMBh4mKawApIpY5Z7YJQCyEkZqdOuiM
