{
  "name": "orbit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A personal CRM for keeping up with the people you care about.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
